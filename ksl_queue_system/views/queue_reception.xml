<?xml version="1.0" encoding="UTF-8" ?>

<!--odoo_view_action-->
<odoo>
    <record id="queue_reception_view_list" model="ir.ui.view">
        <field name="name">queue_reception_view_list</field>
        <field name="model">queue.reception</field>
        <field name="arch" type="xml">
            <list string="queue_reception_list">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="counter_id"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                       decoration-success="state == 'confirm'"/>
            </list>
        </field>
    </record>

    <record id="queue_reception_view_form" model="ir.ui.view">
        <field name="name">queue_reception_view_form</field>
        <field name="model">queue.reception</field>
        <field name="arch" type="xml">
            <form string="queue_reception_form">
                <header>
                    <button name="action_draft" type="object" invisible="state == 'draft'">Draft</button>
                    <button name="action_confirm" type="object" class="btn-primary" invisible="state == 'confirm'">
                        Confirm</button>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="counter_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="queue_reception_view_search" model="ir.ui.view">
        <field name="name">queue_reception_view_search</field>
        <field name="model">queue.reception</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="counter_id"/>
                <field name="state"/>
                <!-- Filter-->
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirm" string="Confirm" domain="[('state', '=', 'confirm')]"/>
                <!-- Group By-->
                <group>
                    <filter string="State" name="group_state"  context="{'group_by':'state'}"/>
                    <filter string="Counter" name="group_counter_id"  context="{'group_by':'counter_id'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="ksl_queue_system_action" model="ir.actions.act_window">
        <field name="name">Reception</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">queue.reception</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_state': True}</field>
    </record>
</odoo>


